{
  "manifest_version": 3,
  "name": "Obsidian 视频剪藏",
  "version": "0.8.1",
  "description": "为 Obsidian 特制：提取 B站、YouTube 与小鹅通现成字幕，支持单人/双人/多人 AI 处理上下文、双语与时间戳。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Obsidian 视频剪藏",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
